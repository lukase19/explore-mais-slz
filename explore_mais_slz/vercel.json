{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "python3 scripts/prepare_vercel.py",
  "outputDirectory": ".vercel-static",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://configure-backend.invalid/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}

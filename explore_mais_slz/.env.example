# Exemplo apenas. O aplicativo lê variáveis do processo; não carrega .env sozinho.
# No Render, render.yaml configura automaticamente banco, HTTPS e duas chaves.
# Gere uma chave real no servidor com: python -c "import secrets; print(secrets.token_hex(32))"
EXPLORE_SECRET_KEY=
EXPLORE_HTTPS=1
# No Render, deixar ausente: backend.hosting usa RENDER_EXTERNAL_URL.
# Para domínio próprio ou outro provedor, definir a origem pública HTTPS:
EXPLORE_PUBLIC_ORIGIN=https://seu-site.example.com
# Caminho absoluto de um SQLite EXISTENTE em disco persistente no servidor Flask.
EXPLORE_DATABASE_PATH=/var/data/explore_slz.db
# Chave separada para o primeiro envio. Render gera automaticamente.
# A importação deixa de existir assim que o banco estiver instalado.
EXPLORE_IMPORT_TOKEN=
# Apenas se optar pelo proxy Vercel; definir NAS VARIÁVEIS DA VERCEL:
# EXPLORE_BACKEND_URL=https://seu-servico.onrender.com

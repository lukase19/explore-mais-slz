# Exemplo apenas. O aplicativo lê variáveis do processo; não carrega .env sozinho.
# Configure-as no painel do servidor Flask. Não são necessárias na Vercel.
# Gere uma chave real no servidor com: python -c "import secrets; print(secrets.token_hex(32))"
EXPLORE_SECRET_KEY=
EXPLORE_HTTPS=1
EXPLORE_PUBLIC_ORIGIN=https://seu-site.vercel.app
# Caminho absoluto de um SQLite EXISTENTE em disco persistente no servidor Flask.
EXPLORE_DATABASE_PATH=/data/explore_slz.db
